; Engine configuration file.
; AIGE runtime test project (created from packages/godot/src/project.ts; windowed for test runs).

config_version=5

[application]

config/name="AIGE Runtime Test"
run/main_scene="res://test.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

Story="*res://addons/aige/Story.cs"
Hud="*res://addons/aige/Hud.cs"
Voice="*res://addons/aige/Voice.cs"
Sfx="*res://addons/aige/Sfx.cs"
Cutscenes="*res://addons/aige/Cutscenes.cs"
AigeTest="*res://addons/aige/Testing/AigeTest.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="RuntimeTest"

