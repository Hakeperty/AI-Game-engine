{
  "format": "aige.project",
  "version": 1,
  "name": "qwen-platformer",
  "description": "",
  "input": {
    "actions": {
      "fire": ["MouseLeft", "KeyJ", "GamepadX"],
      "interact": ["KeyE", "GamepadB"],
      "jump": ["Space", "GamepadA"],
      "pause": ["Escape", "GamepadStart"],
      "sprint": ["ShiftLeft", "GamepadLB"]
    },
    "axes": {
      "move_x": {
        "negative": ["KeyA", "ArrowLeft"],
        "positive": ["KeyD", "ArrowRight"]
      },
      "move_y": {
        "negative": ["KeyS", "ArrowDown"],
        "positive": ["KeyW", "ArrowUp"]
      }
    }
  },
  "physics": {
    "fixedTimestep": 0.01667,
    "gravity": [0, -20, 0]
  },
  "render": {
    "antialias": true,
    "exposure": 1,
    "shadows": true,
    "toneMapping": "neutral"
  },
  "startScene": "scenes/main.scene.json",
  "window": {
    "height": 720,
    "title": "qwen-platformer",
    "width": 1280
  }
}
